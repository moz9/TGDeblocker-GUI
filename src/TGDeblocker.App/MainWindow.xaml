<Window x:Class="TGDeblocker.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:render="using:TGDeblocker.App.Rendering"
 Title="TGDeblocker">
 <Grid x:Name="Root" RequestedTheme="Default" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
  <render:GlassBackdrop x:Name="Glass" IsHitTestVisible="False" />
  <Grid x:Name="ContentSource" Background="{Binding Background, ElementName=Root}">
   <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition x:Name="StatusRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="DragRegion" Margin="18,0,138,0" Background="Transparent">
    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
     <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" />
     <TextBlock Text="TGDeblocker" FontSize="12" FontWeight="SemiBold" />
    </StackPanel>
   </Grid>
   <Grid Grid.Row="2" Margin="24,16,24,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <InfoBar x:Name="DemoBanner" Visibility="Collapsed" IsOpen="False" IsClosable="False" />
    <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0,0,4,12" />
    <ScrollViewer x:Name="PageScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Enabled">
     <StackPanel x:Name="Page" Spacing="16" Padding="0,0,0,94" />
    </ScrollViewer>
   </Grid>
   <Grid Grid.Row="1" Margin="20,0">
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#8C99AD"/><TextBlock x:Name="StatusLabel" Text="Аккаунт не подключён" FontSize="12" /></StackPanel>
   </Grid>
  </Grid>
  <Grid x:Name="GlassHost" IsHitTestVisible="False" />
   <Grid x:Name="Navigation" Margin="22,0,22,20" Height="46" VerticalAlignment="Bottom">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="HomeTab" Tag="home" Style="{StaticResource NavButton}" Click="NavigateClick"><StackPanel Spacing="4"><FontIcon Glyph="&#xE80F;" FontSize="16"/><TextBlock x:Name="HomeLabel" Text="Начало" FontSize="10" Foreground="{Binding Foreground, ElementName=HomeTab}" HorizontalAlignment="Center"/></StackPanel></Button>
    <Button x:Name="DevicesTab" Tag="devices" Grid.Column="1" Style="{StaticResource NavButton}" Click="NavigateClick"><StackPanel Spacing="4"><FontIcon Glyph="&#xE772;" FontSize="16"/><TextBlock x:Name="DevicesLabel" Text="Устройства" FontSize="10" Foreground="{Binding Foreground, ElementName=DevicesTab}" HorizontalAlignment="Center"/></StackPanel></Button>
    <Button x:Name="SecurityTab" Tag="security" Grid.Column="2" Style="{StaticResource NavButton}" Click="NavigateClick"><StackPanel Spacing="4"><FontIcon Glyph="&#xE83D;" FontSize="16"/><TextBlock x:Name="SecurityLabel" Text="Защита" FontSize="10" Foreground="{Binding Foreground, ElementName=SecurityTab}" HorizontalAlignment="Center"/></StackPanel></Button>
    <Button x:Name="SettingsTab" Tag="settings" Grid.Column="3" Style="{StaticResource NavButton}" Click="NavigateClick"><StackPanel Spacing="4"><FontIcon Glyph="&#xE713;" FontSize="16"/><TextBlock x:Name="SettingsLabel" Text="Настройки" FontSize="10" Foreground="{Binding Foreground, ElementName=SettingsTab}" HorizontalAlignment="Center"/></StackPanel></Button>
   </Grid>
 </Grid>
</Window>
