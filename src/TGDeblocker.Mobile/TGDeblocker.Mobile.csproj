<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="'$(TGDeblockerTargetFrameworks)' != ''">$(TGDeblockerTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>TGDeblocker.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>TGDeblocker</ApplicationTitle>
    <ApplicationId>app.tgdeblocker.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.0.1</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <AndroidPackageFormats>aab;apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <ProjectReference Include="../TGDeblocker.Core/TGDeblocker.Core.csproj" />
    <Compile Include="../TGDeblocker.App/AppStrings.cs" Link="Localization/AppStrings.cs" />
    <Compile Include="../Shared/ThemePreference.cs" Link="Appearance/ThemePreference.cs" />
    <Compile Include="../Shared/TelegramPalette.cs" Link="Appearance/TelegramPalette.cs" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#268FE6" />
    <MauiSplashScreen Include="Resources/AppIcon/appicon.svg" Color="#FFFFFF" BaseSize="96,96" />
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(TelegramApiCredentialsFile)" LogicalName="TGDeblocker.Mobile.telegram-api.json" Condition="'$(TelegramApiCredentialsFile)' != '' and Exists('$(TelegramApiCredentialsFile)')" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidNativeLibrary Include="Native/Android/arm64-v8a/*.so" Condition="'$(RuntimeIdentifier)' == 'android-arm64' or $([System.String]::Copy('$(RuntimeIdentifiers)').Contains('android-arm64'))" />
    <AndroidNativeLibrary Include="Native/Android/x86_64/*.so" Condition="'$(RuntimeIdentifier)' == 'android-x64' or $([System.String]::Copy('$(RuntimeIdentifiers)').Contains('android-x64'))" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <BundleResource Include="Platforms/iOS/PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
    <NativeReference Include="Native/iOS/TDLib.xcframework" Condition="Exists('Native/iOS/TDLib.xcframework')">
      <Kind>Static</Kind><ForceLoad>true</ForceLoad><IsCxx>true</IsCxx>
      <Frameworks>Foundation Security</Frameworks><LinkerFlags>-lz -lc++</LinkerFlags>
    </NativeReference>
  </ItemGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and Exists('Native/iOS/TDLib.xcframework')">
    <DefineConstants>$(DefineConstants);TDLIB_IOS_NATIVE</DefineConstants>
  </PropertyGroup>
  <Target Name="RequireNativeTelegramForRelease" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="'$(TelegramApiCredentialsFile)' == '' or !Exists('$(TelegramApiCredentialsFile)')" Text="Release builds require the publisher's Telegram API configuration. Use tools/build-mobile.ps1; see the mobile README." />
    <Error Condition="'$(TargetFramework)' == 'net10.0-android' and ('$(RuntimeIdentifier)' == 'android-arm64' or $([System.String]::Copy('$(RuntimeIdentifiers)').Contains('android-arm64'))) and !Exists('Native/Android/arm64-v8a/libtdjson.so')" Text="Build the ARM64 TDLib library first; see tools/README-tdlib-mobile.md." />
    <Error Condition="'$(TargetFramework)' == 'net10.0-android' and ('$(RuntimeIdentifier)' == 'android-x64' or $([System.String]::Copy('$(RuntimeIdentifiers)').Contains('android-x64'))) and !Exists('Native/Android/x86_64/libtdjson.so')" Text="Build the x86_64 TDLib library first; see tools/README-tdlib-mobile.md." />
    <Error Condition="'$(TargetFramework)' == 'net10.0-ios' and !Exists('Native/iOS/TDLib.xcframework')" Text="Build TDLib.xcframework on macOS before creating an iOS release." />
  </Target>
</Project>
